# Copia este archivo como ".env" y completa los valores. ".env" NO se sube a Git.

# Puerto serie del LiDAR (Windows: COM3 | Linux: /dev/ttyUSB0 o /dev/ttyACM0)
LIDAR_PORT=COM3

# Alertas de Telegram (BotFather te da el token; el chat id lo obtienes con @userinfobot o getUpdates)
TELEGRAM_BOT_TOKEN=PON_AQUI_TU_TOKEN
TELEGRAM_CHAT_ID=PON_AQUI_TU_CHAT_ID

# Panel en AWS (opcional): el monitor envia estado y alertas a tu servidor
# PROXISENSE_SERVER_URL=https://tu-dominio.duckdns.org
# PROXISENSE_API_KEY=la_misma_clave_del_servidor
# PROXISENSE_DEVICE=casa
